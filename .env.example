# Copy this file to .env (for local dev) and ALSO add these same
# variables in your hosting provider's dashboard (Vercel/Netlify/etc)
# under Environment Variables — Vite only bakes in values that exist
# at BUILD time, so setting them only locally will not fix production.

# EmailJS — https://dashboard.emailjs.com
VITE_EMAILJS_SERVICE_ID=service_f4zmxdt
VITE_EMAILJS_TEMPLATE_ID=template_xz46ktb
# Account → General → Public Key (NOT the private key)
VITE_EMAILJS_PUBLIC_KEY=your_public_key

# Where new-booking / new-demo notification emails go
VITE_ADMIN_EMAIL=triangle.humanresources@gmail.com

# Note: Supabase URL/anon key are currently hardcoded in
# src/lib/supabase.js rather than read from env vars. That's not
# this bug, but worth moving to env vars later too.
